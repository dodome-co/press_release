# 置き場所：/etc/press-release.env （所有者 root・グループ pressrel・権限 640。ほかのユーザーには読めない。Git には入れない）
# 例の値を、自分のものに書き換える。

APP_ENV=demo
FLASK_APP=app:create_app

# 推測されない長い値：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ここに長いランダムな文字列

# 公開する IP アドレス（VM の外部 IP。固定の IP にしておく）
BASE_URL=http://203.0.113.10
TRUSTED_HOSTS=203.0.113.10

# データベースとアップロードの保存先（systemd が書き込みを許す場所）
# 既定は SQLite。MySQL にするときは、下の行に差し替える（手順書の「MySQL を使うとき」を参照。パスワードは、手順書で決めたもの）
DATABASE_URL=sqlite:////var/lib/press-release/app.sqlite3
# DATABASE_URL=mysql+pymysql://press_release:ここにパスワード@127.0.0.1:3306/press_release?charset=utf8mb4
UPLOAD_DIR=/var/lib/press-release/uploads

# Stripe は、テスト用のキーだけ（sk_test_ 以外だと、起動しない）
STRIPE_SECRET_KEY=sk_test_ここにテスト用のキー
# 手順書の手順8で、Stripe に Webhook を登録したあと、表示される値に書き換える。それまでは、この仮の値でよい
# （値に、空白や日本語を入れない。読み込むときに、別のコマンドとして扱われて、設定が空になる）
STRIPE_WEBHOOK_SECRET=whsec_dummy_replace_later

# メールは送らず、管理者の画面で見せる
MAIL_BACKEND=database

# About Us に載せる運営者の情報
OPERATOR_NAME=ゆきわり。
COMPANY_ADDRESS=
SUPPORT_EMAIL=

# デモのサンプルデータの、共通のパスワード（任意。決めないと、既定のパスワードになる）
# DEMO_PASSWORD=
