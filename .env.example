# コピーして .env を作る（.env は Git に入れない）
FLASK_APP=app:create_app
# 開発では development にする。未設定だと production（本番）として動き、下の本番用の設定が必須になる
APP_ENV=development
SECRET_KEY=change-me
# 開発は SQLite、本番は MySQL の接続文字列に切り替える
DATABASE_URL=sqlite:///dev.sqlite3
# MySQL の例（文字コードは utf8mb4。パスワードに記号があるときは、URL の形式に直す）：
# DATABASE_URL=mysql+pymysql://press_release:パスワード@127.0.0.1:3306/press_release?charset=utf8mb4
# MySQL で全テストを通すときの、テスト専用のデータベース（テストのたびに全テーブルを作って消すので、本物のデータは入れない）：
# TEST_DATABASE_URL=mysql+pymysql://press_release:パスワード@127.0.0.1:3306/press_release_test?charset=utf8mb4

# ---- 決済（Stripe）。開発ではテスト用のキー（sk_test_ で始まるもの）を使う ----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...     # ローカルでは `stripe listen` が表示する値
# SUPPORT_EMAIL=                      # お問い合わせ先（About Us・サービス案内・メールに載せる。空なら「準備中」と表示される）
# COMPANY_ADDRESS=                    # 運営者の所在地（About Us に載せる。個人の連絡先は、Git に入れず、ここで設定する）
# OPERATOR_NAME=ゆきわり。            # 運営者の会社名（About Us に載せる）
# PRICE_ARTICLE_CREATION=10000       # 料金は、PRICE_<サービスの種類> で上書きできる
# PRICE_INTERVIEW_PLANNING_IWATE=80000  # 地域や動画の長さで変わるもの：_IWATE など、動画は PRICE_VIDEO_CREATION_WITHIN_1MIN / _1_TO_3MIN / _3_TO_8MIN

# ---- 回数制限（既定のまま使える。変えたいときだけ）----
# RATE_LIMIT_ENABLED=1                # 0 にすると、回数制限をしない
# RATE_LOGIN_FAIL_MAX=5               # 同じメールアドレスで、ログインの失敗が、この回数に達したら止める
# RATE_LOGIN_FAIL_SECONDS=900         #   ↑ この秒数の間（15分）
# RATE_LOGIN_IP_MAX=20                # 同じ IP からの、ログインの試行（10分に20回）
# RATE_REGISTER_IP_MAX=10             # 同じ IP からの、会員登録（1時間に10回）
# RATE_RESET_IP_MAX=5                 # 同じ IP からの、パスワード再設定の依頼（1時間に5回）
# RATE_RESET_EMAIL_MAX=3              # 同じメールアドレス宛ての、再設定メール（1時間に3通）
# RATE_ORDER_USER_MAX=10              # 同じ会員の、申込み（10分に10回）

# ---- 本番だけで必要（開発では不要）----
# BASE_URL=https://example.com        # メールのリンクに使う土台の URL（https 必須）
# TRUSTED_HOSTS=example.com           # 許可するドメイン（カンマ区切り）。それ以外の Host は拒否される
# PROXY_FIX=1                         # Nginx の後ろで動かすとき（本番の既定）
# MAIL_BACKEND=...                    # 本番用のメール送信方法（未決。console は開発専用）
